# VibeCheck Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file.

# GitHub Token (optional, increases API rate limit from 60 to 5000/hour)
# Create at: https://github.com/settings/tokens (read-only, no scopes needed)
GITHUB_TOKEN=

# Maximum extracted size of one repository file, hard-capped at 50 MB.
MAX_SINGLE_FILE_SIZE=26214400

# LLM API Key (for AI-powered explanations of non-sensitive issues)
LLM_API_KEY=

# CORS allowed origins (JSON array, no wildcard "*")
# Frontend origin(s) permitted to make cross-origin requests to the backend
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
