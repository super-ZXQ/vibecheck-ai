# Required public URLs/origins for docker-compose.production.yml.
# Copy to a private local file and pass it with --env-file.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
TRUSTED_HOSTS=["localhost","127.0.0.1"]
BACKEND_TMPFS_SIZE=320m

# Optional. A read-only token only increases the public GitHub rate limit.
GITHUB_TOKEN=

# Bind to loopback by default. Change deliberately when placing a TLS proxy
# in front of the services.
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=3000
