# Production compose (PostgreSQL-backed).
# Copy to a private local file and pass with --env-file. NEVER commit secrets.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
TRUSTED_HOSTS=["localhost","127.0.0.1","vibecheck.example.com"]
BACKEND_TMPFS_SIZE=320m
MAX_SINGLE_FILE_SIZE=26214400

# PostgreSQL (required). Use strong unique passwords outside CI smoke.
POSTGRES_USER=vibecheck
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vibecheck

# Optional. A read-only token only increases the public GitHub rate limit.
GITHUB_TOKEN=

# Bind to loopback by default. Change deliberately when placing a TLS proxy
# in front of the services.
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=8000
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=3000
